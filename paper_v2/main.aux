\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  \textbf  {Failure of SER attacks due to decision interface mismatch.} \textbf  {(A)} SER attacks are optimized to cross classifier decision boundaries, while Audio LLMs determine emotion through a compact top-$k$ token interface during autoregressive decoding. This mismatch prevents perturbations from reaching the actual decision interface. \textbf  {(B)} As a result, all existing SER attacks exhibit low transferability (typically $<10\%$ prediction change rate) on Audio LLMs, despite strong performance on surrogate SER models. }}{5}{figure.4}\protected@file@percent }
\newlabel{fig:obs3}{{4}{5}{\textbf {Failure of SER attacks due to decision interface mismatch.} \textbf {(A)} SER attacks are optimized to cross classifier decision boundaries, while Audio LLMs determine emotion through a compact top-$k$ token interface during autoregressive decoding. This mismatch prevents perturbations from reaching the actual decision interface. \textbf {(B)} As a result, all existing SER attacks exhibit low transferability (typically $<10\%$ prediction change rate) on Audio LLMs, despite strong performance on surrogate SER models}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  \textbf  {Cross-model emotion competition fields.} All models exhibit soft competition among candidate emotions, but their dominant bias centers differ: Qwen2-Audio tends toward \textit  {angry}, Voxtral-Mini falls back to \textit  {neutral}, and SALMONN is attracted to \textit  {happy}. }}{5}{figure.5}\protected@file@percent }
\newlabel{fig:obs4_competition}{{5}{5}{\textbf {Cross-model emotion competition fields.} All models exhibit soft competition among candidate emotions, but their dominant bias centers differ: Qwen2-Audio tends toward \textit {angry}, Voxtral-Mini falls back to \textit {neutral}, and SALMONN is attracted to \textit {happy}}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  \textbf  {Layer-wise emotion separability.} Emotion probing performance peaks at intermediate layers across all models, indicating that the effective control boundary emerges before decoding. }}{5}{figure.6}\protected@file@percent }
\newlabel{fig:obs5_layer}{{6}{5}{\textbf {Layer-wise emotion separability.} Emotion probing performance peaks at intermediate layers across all models, indicating that the effective control boundary emerges before decoding}{figure.6}{}}
