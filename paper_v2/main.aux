\newlabel{sec:method-tempo}{{V}{6}{TEMPO: Topology-Guided Emotion Manipulation by Pairwise Optimization}{section.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-A}}Topology Bank: Modeling the Emotion Competition Field}{6}{subsection.5.1}\protected@file@percent }
\newlabel{subsec:tempo-topology}{{\mbox  {V-A}}{6}{Topology Bank: Modeling the Emotion Competition Field}{subsection.5.1}{}}
\newlabel{eq:topology-bank}{{3}{6}{Topology Bank: Modeling the Emotion Competition Field}{equation.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Overview of \textsc  {TEMPO}.} \textsc  {TEMPO} converts clean-side observations into a topology prior, plans a pair-specific transition route, and optimizes adversarial audio through layer-adaptive control and margin-aware scheduling. The attack is not a one-step target-token maximization problem; it is a controlled transition that escapes the source region, follows a feasible route, and consolidates target dominance under semantic and perceptual constraints.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:tempo-overview}{{7}{7}{\textbf {Overview of \textsc {TEMPO}.} \textsc {TEMPO} converts clean-side observations into a topology prior, plans a pair-specific transition route, and optimizes adversarial audio through layer-adaptive control and margin-aware scheduling. The attack is not a one-step target-token maximization problem; it is a controlled transition that escapes the source region, follows a feasible route, and consolidates target dominance under semantic and perceptual constraints}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Abstract emotion competition field.} The source emotion $e_s$ competes with a dominant competitor $k_m(s)$ and the attacker-chosen target $e_t$. The attack objective is therefore not merely to increase the target score, but to overcome the model's natural competition bias.}}{7}{figure.8}\protected@file@percent }
\newlabel{fig:tempo-topology-field}{{8}{7}{\textbf {Abstract emotion competition field.} The source emotion $e_s$ competes with a dominant competitor $k_m(s)$ and the attacker-chosen target $e_t$. The attack objective is therefore not merely to increase the target score, but to overcome the model's natural competition bias}{figure.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-B}}Pair-wise Hardness and Route Planning}{7}{subsection.5.2}\protected@file@percent }
\newlabel{subsec:tempo-route}{{\mbox  {V-B}}{7}{Pair-wise Hardness and Route Planning}{subsection.5.2}{}}
\newlabel{eq:tempo-route}{{4}{7}{Pair-wise Hardness and Route Planning}{equation.4}{}}
\newlabel{eq:tempo-waypoint}{{5}{7}{Pair-wise Hardness and Route Planning}{equation.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Pair-wise attack hardness.} $H_m(s,t)$ quantifies how difficult it is to flip a source emotion $s$ into a target emotion $t$. The hardness is asymmetric and pair-dependent, motivating pair-specific route planning.}}{8}{figure.9}\protected@file@percent }
\newlabel{fig:tempo-hardness}{{9}{8}{\textbf {Pair-wise attack hardness.} $H_m(s,t)$ quantifies how difficult it is to flip a source emotion $s$ into a target emotion $t$. The hardness is asymmetric and pair-dependent, motivating pair-specific route planning}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Topology-aware route planning.} Easy pairs follow a direct transition, while hard pairs use a waypoint-assisted route to avoid collapse into the dominant competitor or bias center.}}{8}{figure.10}\protected@file@percent }
\newlabel{fig:tempo-route-example}{{10}{8}{\textbf {Topology-aware route planning.} Easy pairs follow a direct transition, while hard pairs use a waypoint-assisted route to avoid collapse into the dominant competitor or bias center}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Multi-phase control in \textsc  {TEMPO}.} The attack first exits the source region, then steers the representation along a target-consistent direction, and finally consolidates the target by reordering the output competition margins.}}{8}{figure.11}\protected@file@percent }
\newlabel{fig:tempo-layer-control}{{11}{8}{\textbf {Multi-phase control in \textsc {TEMPO}.} The attack first exits the source region, then steers the representation along a target-consistent direction, and finally consolidates the target by reordering the output competition margins}{figure.11}{}}
